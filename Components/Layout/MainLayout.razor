@inherits LayoutComponentBase
<RadzenComponents />
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenImage Path="images/Optical-disc-with-solid-fill.png" style="width: 48px; height: 48px; text-align: left" AlternateText="Application logo"></RadzenImage>
            <RadzenLabel Text="Ksar Capital" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Path="" />
            <RadzenPanelMenuItem Text="About" Path="about" />
            <RadzenPanelMenuItem Text="Projects" Path="projects" />
            <RadzenPanelMenuItem Text="Contact Us" Path="contact--us" />
        </RadzenPanelMenu>
     </RadzenSidebar>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
    <RadzenFooter>
        <p id="ici70r" class="smallText" style="text-align: center; font-family: Verdana; font-size: 10px;">Ksar Capital Copyright Ⓒ 2024 .&nbsp;</p>
        <button onclick="window.location.href='https://twitter.com/srossi5619'" type="button" value="https://twitter.com/srossi5619" id="inanrx" class="button1" style="margin-left: auto; margin-right: 0;">X</button>
        <button onclick="window.location.href='https://www.linkedin.com/in/srossiitconsulting'" type="button" value="https://www.linkedin.com/in/srossiitconsulting" id="i6ow4z" class="button2">In</button>
        <script id="iw9bj2">
            document.getElementById('year').innerHTML = new Date().getFullYear();
        </script>

    </RadzenFooter>
</RadzenLayout>

