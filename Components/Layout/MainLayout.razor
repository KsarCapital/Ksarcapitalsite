@inherits LayoutComponentBase
<RadzenComponents />
<RadzenLayout Style="grid-template-columns: 1fr auto; grid-template-areas: 'rz-header rz-header' 'rz-body rz-sidebar' 'rz-footer rz-footer'">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenImage Path="images/Optical-disc-with-solid-fill.png"  style="width: 48px; height: 48px; text-align: left" AlternateText="Application logo"></RadzenImage>
            <RadzenLabel Text="Ksar Capital" Style="text-align: left" />
            <RadzenSidebarToggle Click="@SidebarToggleClick" Class="rz-m-0" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
 <!--       <RadzenStack AlignItems="Radzen.AlignItems.Center" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding); border-bottom: var(--rz-panel-menu-item-border);">
